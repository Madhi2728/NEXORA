# Set to "production" on a real deployment. In any other value (or unset) the
# CORS layer also accepts localhost/127.0.0.1 on any port, and a missing
# RESEND_API_KEY falls back to printing OTP codes to the server console.
NODE_ENV=development

PORT=5000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/healthcare_db
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# Allowed browser origin(s) for CORS. Single value, or a comma-separated
# allowlist: CLIENT_URL=http://localhost:5173,https://app.nexora.health
# The frontend dev server is pinned to 5173 (vite strictPort) so this matches.
CLIENT_URL=http://localhost:5173

# Optional: leave blank to just log OTPs to the server console during dev
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=Nexora Healthcare <no-reply@nexora.health>

# Azure AI Vision (Read API) — enables handwriting recognition for
# Prescription OCR. Leave blank to fall back to Tesseract (printed text only).
AZURE_VISION_ENDPOINT=
AZURE_VISION_KEY=

# OCR.space (https://ocr.space/ocrapi) — free, simple alternative to Azure/Google.
# Used automatically if Azure isn't configured.
OCR_SPACE_API_KEY=

# OpenAI (chatbot) — get a key at platform.openai.com
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

# ---------------------------------------------------------------------------
# Email OTP (registration verification + password reset) — sent via SMTP
# ---------------------------------------------------------------------------
# Gmail: enable 2-Step Verification, then create an App Password at
# https://myaccount.google.com/apppasswords and paste the 16-char value
# (no spaces) as SMTP_PASS. SMTP_USER is your full Gmail address.
# Leave SMTP_HOST/SMTP_USER/SMTP_PASS blank in dev to print OTP codes to the
# console instead (tagged "[DEV OTP]"); NODE_ENV=production refuses to start
# sending mail without SMTP configured rather than silently dropping codes.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# "Display Name <address>" — for Gmail this should be your SMTP_USER address
# (Gmail rewrites the From address to the authenticated account regardless).
MAIL_FROM=Nexora Health <no-reply@nexora.health>

# OTP tuning
OTP_LENGTH=4
OTP_SIGNUP_TTL_MINUTES=10
OTP_RESET_TTL_MINUTES=15
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_SENDS_PER_HOUR=5
