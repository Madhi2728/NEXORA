PORT=5000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/healthcare_db
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173

# Optional: leave blank to just log OTPs to the server console during dev
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=Nexora Healthcare <no-reply@nexora.health>

# Azure AI Vision (Read API) — enables handwriting recognition for
# Prescription OCR. Leave blank to fall back to Tesseract (printed text only).
AZURE_VISION_ENDPOINT=
AZURE_VISION_KEY=

# OCR.space (https://ocr.space/ocrapi) — free, simple alternative to Azure/Google.
# Used automatically if Azure isn't configured.
OCR_SPACE_API_KEY=

# OpenAI (chatbot) — get a key at platform.openai.com
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

# ---------------------------------------------------------------------------
# Email OTP (registration verification + password reset)
# ---------------------------------------------------------------------------
# Email provider: "smtp" or "resend"
MAIL_PROVIDER=smtp
MAIL_FROM_NAME=Nexora Health
MAIL_FROM_EMAIL=no-reply@nexora.health

# SMTP (Gmail app password, Mailtrap, etc.)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Resend (used only when MAIL_PROVIDER=resend)
RESEND_API_KEY=

# OTP tuning
OTP_LENGTH=6
OTP_SIGNUP_TTL_MINUTES=10
OTP_RESET_TTL_MINUTES=15
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_SENDS_PER_HOUR=5
